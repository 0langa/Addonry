{
  "mcpServers": {
    "addonry-chrome-devtools": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$roots = @($env:CLAUDE_PLUGIN_ROOT, $env:KIMI_PLUGIN_ROOT, $env:PLUGIN_ROOT, (Get-Location).Path) | Where-Object { $_ }; & (Join-Path $roots[0] 'scripts/start-chrome-devtools-mcp.ps1')"
      ],
      "cwd": "./"
    }
  }
}
