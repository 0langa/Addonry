{
  "manifest_version": 3,
  "name": "Cross Browser Smoke",
  "version": "0.1.0",
  "description": "Verifies shared popup behavior in Chrome and Firefox.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cross Browser Smoke",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "scripts": [
      "src/service-worker.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4e49619c-865d-4e98-a1e7-f4a036f8f2e8}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
